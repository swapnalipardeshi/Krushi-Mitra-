# ====================================================================
# KRUSHI MITRA - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ====================================================================
# Copy this file to '.env' and populate with your own project credentials.
# NEVER commit the actual '.env' file or production secrets to Git!
# ====================================================================

# 1. Google Gemini AI & Groq LLM
# Primary AI advisor and high-speed fallback keys
GEMINI_KEY_1=your_gemini_key_1_here
GEMINI_KEY_2=your_gemini_key_2_here
GEMINI_KEY_3=your_gemini_key_3_here
GEMINI_KEY_4=your_gemini_key_4_here
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_KEY_2=your_backup_groq_api_key_here

# 2. Weather Service
# OpenWeatherMap API key (Free tier at https://openweathermap.org/api)
# Note: If omitted, the app automatically falls back to Open-Meteo live meteorological data.
OPENWEATHER_KEY=your_openweathermap_api_key_here

# 3. Official Mandi APMC Prices
# National Agriculture Market (Data.gov.in Agmarknet Resource API Key)
# Note: If omitted, the app automatically serves verified government MSP benchmark data.
AGMARKET_KEY=your_datagov_agmarknet_api_key_here
