# ====================================================================
# KRUSHI MITRA - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ====================================================================
# Copy this file to '.env' and populate with your own project credentials.
# NEVER commit the actual '.env' file or production secrets to Git!
# ====================================================================

# 1. Supabase Configuration (Primary Application Backend)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_publishable_anon_key_here

# 2. Google Gemini AI (Optional Client-Side Fallback)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_KEY_1=your_backup_gemini_key_1_here
GEMINI_KEY_2=your_backup_gemini_key_2_here

# 3. Weather Service
OPENWEATHER_KEY=your_openweathermap_api_key_here

# 4. Official Mandi APMC Prices
AGMARKET_KEY=your_datagov_agmarknet_api_key_here

# 5. Groq Fast LLM Fallback (Optional)
GROQ_API_KEY=your_groq_api_key_here

